# ============================================
# VMOS Cloud API Credentials
# Get from: https://cloud.vmoscloud.com
#   -> API Management -> Access Key ID + Secret Access Key
# ============================================
VMOS_API_KEY=your_access_key_id_here
VMOS_API_SECRET=your_secret_access_key_here
VMOS_BASE_URL=https://api.vmoscloud.com

# ============================================
# VMOS Dashboard Login
# The email + password you use to log into cloud.vmoscloud.com
# Used once on first run to scrape your phone pad codes
# ============================================
VMOS_DASHBOARD_EMAIL=your_dashboard_email_here
VMOS_DASHBOARD_PASSWORD=your_dashboard_password_here

# ============================================
# SMS Verification (GetAText)
# Get from: https://getatext.com -> API key
# ============================================
SMS_PROVIDER=getatext
SMS_API_KEY=your_getatext_api_key_here
SMS_SERVICE=match
SMS_COUNTRY=us

# ============================================
# Match.com App Package (do not change)
# ============================================
MATCH_APP_PACKAGE=com.match.android.matchmobile

# ============================================
# Proxy
# Put your proxy lines in config/proxies.txt
# ============================================
PROXY_FILE=config/proxies.txt
PROXY_ROTATION=round_robin
